# SonicSentinel AI — environment variables (copy to .env and fill in).
# NEVER commit a real .env file. .env is git-ignored.

# Flask session secret. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SONICSENTINEL_SECRET_KEY=

# Background training (default on). Set to 0 to disable retraining while the app runs.
SONIC_BG_TRAIN=1
# How often (seconds) the background trainer re-checks for new data.
SONIC_TRAIN_INTERVAL=900

# Training parallelism. 1 is safest on low-RAM machines; raise on bigger hosts.
SONIC_N_JOBS=1

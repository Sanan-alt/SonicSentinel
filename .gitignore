# (SRS section 3 wants these committed).
data/raw/
data/processed/
data/audio_dataset/
data/augmented/
data/**/*.wav
data/**/*.mp3
data/**/*.flac
data/**/*.ogg
data/**/*.m4a

# ---- Generated ML artefacts + runtime data ----
*.npz
python_models/
gtm_model/
sonicsentinel_data/
uploads/
visuals/
*.db
*.sqlite
*.sqlite3

# reports/: ignore heavy binaries, KEEP the committable evidence (json/csv/md/png).
# (SRS sections 4 & 6 want these committed; they are small.)
reports/**/*.joblib
reports/**/*.npz
reports/**/*.wav

# ---- Extracted / temporary working files ----
srs_text.txt
_extract_pdf.py

